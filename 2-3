#include <iostream>
using namespace std;

int main() {
    string menu[5] = {"Soto", "Rawon","Pecel","Teh","Kopi"};
    int harga[5] = {10000, 20000,10000,3000,5000};
    int porsi[5];
    int total[5];

    for(int i = 0; i < 5; i++) {
        cout << "=================================" << endl;
        cout << "Menu   : " << menu[i] << endl;
        cout << "Harga  : " << harga[i] << endl;
        cout << "Porsi  : ";
        cin >> porsi[i];

        total[i] = porsi[i] * harga[i];

        cout << "Total  : " << total[i] << endl;
        cout << "=================================" << endl;
    }

    return 0;
}
